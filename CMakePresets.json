      "name": "x64-debug",
      "configurePreset": "vs-x64",
      "configuration": "Debug"
    },
    {
      "name": "x64-release",
      "configurePreset": "vs-x64",
      "configuration": "Release"
    },
    {
      "name": "x86-debug",
